# Optional Personal Spotify API credentials. Copy this file to `.env` (project root).
# Not required for basic usage (Musique uses built-in public PKCE grant by default).
# If providing personal credentials, set Redirect URI in dashboard to:
#   http://127.0.0.1:8989/login
#
# these are read ONLY by the Rust backend at startup and seeded into the OS, so blame windows for lack of hot reload :3
# keyring / local DB on first run, the secret never reaches the frontend
# editing credentials in the in-app Settings page overrides these
#
#
# UPDATE: new in-memory db

SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
